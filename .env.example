# Copy to .env (gitignored) and fill in real values before `docker-compose up`.
# Every variable here is read by docker-compose.yml to configure the stack.

# Required: docker-compose refuses to start the backend without this set.
JWT_SECRET=

REDIS_PASSWORD=
CLIENT_ORIGIN=http://localhost:3009
TRUST_PROXY=loopback, uniquelocal

# MySQL applies both passwords only when it initialises an empty mysql-data volume.
# Changing one later does not change it inside MySQL: change it there first (ALTER USER).
# A DB_APP_PASSWORD that MySQL does not know gets the backend refused ("Access denied"),
# and it keeps restarting.
MYSQL_ROOT_PASSWORD=root
# Password for the app's MySQL user, shared by the mysql-db and backend services.
DB_APP_PASSWORD=1234

# Leave empty to boot without mail: registration signs in without confirming the
# email, and password recovery answers 503.
RESEND_API_KEY=
# Required once RESEND_API_KEY is set: an address on a domain verified in Resend.
# The default onboarding@resend.dev sender reaches only the Resend account owner,
# so no other player could confirm a registration or receive a reset link.
RESEND_FROM=

# Support address shown in the FAQ (baked into the frontend build). Empty sends
# players to the site chat only, which chat-muted and banned players cannot use.
REACT_APP_SUPPORT_EMAIL=
